# Throwaway values for the variables docker-compose.yml requires through `${VAR:?}`. `make
# check-compose` sources this file with `set -a` before each Compose call, so these outrank both
# .env.example and any value the caller exported, and the resolved file never carries .env's or the
# shell's real secrets (ADR-049). Nothing ever runs on these: `config` starts no container. Since
# /bin/sh reads it, each value is a plain word. tests/test_compose_check.py keeps the names equal to
# the file's `:?` variables, and each value plain.
POSTGRES_PASSWORD=compose-check-placeholder
LEDGER_DB_PASSWORD=compose-check-placeholder
KEYCLOAK_DB_PASSWORD=compose-check-placeholder
KEYCLOAK_ADMIN_PASSWORD=compose-check-placeholder
FINASSIST_OWNER_INITIAL_PASSWORD=compose-check-placeholder
GATEWAY_CLIENT_SECRET=compose-check-placeholder
ASSISTANT_CLIENT_SECRET=compose-check-placeholder
GRAFANA_ADMIN_PASSWORD=compose-check-placeholder
