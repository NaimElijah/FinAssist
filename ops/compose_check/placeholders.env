# Throwaway values for the variables docker-compose.yml requires through `${VAR:?}`, layered over
# .env.example by `make check-compose`, so the Compose file resolves without .env, which on a
# developer machine holds the owner's secrets (ADR-049). Nothing ever runs on these: `config` starts
# no container. tests/test_compose_check.py keeps the names equal to the file's `:?` variables.
POSTGRES_PASSWORD=compose-check-placeholder
LEDGER_DB_PASSWORD=compose-check-placeholder
KEYCLOAK_DB_PASSWORD=compose-check-placeholder
KEYCLOAK_ADMIN_PASSWORD=compose-check-placeholder
FINASSIST_OWNER_INITIAL_PASSWORD=compose-check-placeholder
GATEWAY_CLIENT_SECRET=compose-check-placeholder
ASSISTANT_CLIENT_SECRET=compose-check-placeholder
GRAFANA_ADMIN_PASSWORD=compose-check-placeholder
