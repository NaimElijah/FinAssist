{
  "realm": "finassist",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 36000,
  "revokeRefreshToken": false,
  "eventsListeners": [],
  "roles": {
    "realm": [
      { "name": "owner", "description": "Reads and writes the ledger; held by the owner alone." },
      { "name": "viewer", "description": "Reads the ledger; held by anyone the owner adds." },
      { "name": "assistant", "description": "The assistant's service principal; reads the ledger only." }
    ]
  },
  "scopeMappings": [
    { "client": "finassist-gateway", "roles": ["owner", "viewer"] },
    { "client": "finassist-assistant", "roles": ["assistant"] }
  ],
  "clients": [
    {
      "clientId": "finassist-gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["${GATEWAY_PUBLIC_URL}/bff/login/oauth2/code/keycloak"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${GATEWAY_PUBLIC_URL}/"
      },
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "finassist-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "finassist-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "finassist-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "finassist-assistant-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "finassist-assistant",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "finassist-assistant",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${ASSISTANT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "finassist-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "finassist-ledger-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "finassist-ledger",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-cli",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "id": "6c4a4be0-7c38-4145-845f-f4311ef64202",
      "username": "${FINASSIST_OWNER_USERNAME}",
      "enabled": true,
      "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "${FINASSIST_OWNER_INITIAL_PASSWORD}",
          "temporary": true
        }
      ],
      "realmRoles": ["owner"]
    },
    {
      "username": "service-account-finassist-assistant",
      "enabled": true,
      "serviceAccountClientId": "finassist-assistant",
      "realmRoles": ["assistant"]
    }
  ]
}
