<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.naimelijah.finassist</groupId>
  <artifactId>ledger</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>FinAssist Ledger</name>
  <description>Accounts, transactions and the invariants that govern them</description>

  <properties>
    <!-- Toolchain pin. Spring Boot 4.1's baseline is 17; 21 is the installed LTS. -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spotless.version>3.10.1</spotless.version>
    <palantir-java-format.version>2.97.0</palantir-java-format.version>
    <archunit.version>1.5.0</archunit.version>
    <jacoco.version>0.8.13</jacoco.version>
    <pitest.version>1.19.1</pitest.version>
    <pitest-junit5.version>1.2.2</pitest-junit5.version>
    <springdoc.version>3.1.1</springdoc.version>
  </properties>

  <dependencies>
    <!-- spring-boot-starter-web is deprecated in favor of this one as of Boot 4.1.1. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- Generates the ledger's OpenAPI document from the code (ADR-028); the -api artifact only,
         no Swagger UI. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- Health and readiness endpoints are a baseline requirement, not a later addition. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Makes the ledger a resource server: validates the bearer token itself and denies by default
      (ADR-030). This single starter is also what switches on Boot's authenticate-everything default
      chain, which is why it arrives together with LedgerSecurityConfiguration, which states the real
      rules, in the same commit. Nimbus (com.nimbusds:nimbus-jose-jwt) arrives transitively through
      spring-security-oauth2-jose, which this starter pulls in; it is deliberately not declared here,
      because a test-scoped declaration would override the compile-scope one this starter needs.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- OTLP traces and metrics. Exports nothing when OTEL_EXPORTER_OTLP_ENDPOINT is unset,
         which is the contract .env.example publishes (ADR-019). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Puts /actuator/prometheus on the wire; version managed by the imported micrometer-bom. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- JdbcClient, a DataSource and HikariCP. No JPA and no Spring Data: every statement the
         ledger issues is written by hand, which is what makes ADR-020's append-only obligation
         reviewable rather than a property of an ORM's flush behaviour (ADR-024). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Not org.flywaydb:flyway-core. Boot 4 splits autoconfiguration into per-technology
         modules, and the bare library would migrate nothing at start-up. This brings both. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <!-- Flyway 10+ ships each database's support separately; without this it cannot parse
         PostgreSQL DDL. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @WebMvcTest and MockMvc; spring-boot-starter-test alone does not provide them on Boot 4. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      SecurityMockMvcRequestPostProcessors.jwt(), and the MockMvcBuilderCustomizer
      (SecurityMockMvcAutoConfiguration) that applies Spring Security to every @WebMvcTest slice's
      MockMvc automatically. Also where TestTokens gets Nimbus's RSAKeyGenerator, PlainJWT and
      MACSigner from, transitively, to mint real signed tokens for LedgerAuthorizationIT.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- InMemorySpanExporter, so a test can assert a span was recorded without a collector. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Layering and dependency direction are enforced by the build, not by review. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!--
      A real PostgreSQL for the *IT tests, on the same image tag as docker-compose.yml, so what
      CI proves is what a developer runs (ADR-025). Docker is required: these tests fail rather
      than skip when it is absent, because a green suite that exercised none of the SQL is worse
      than one that refuses to run.

      Testcontainers 2 renamed the modules - `testcontainers-postgresql`, not `postgresql` - and
      moved PostgreSQLContainer to org.testcontainers.postgresql. The 1.x coordinates and package
      still resolve and are deprecated.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Formatter is authoritative: `spotless:check` gates CI, `spotless:apply` fixes. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
      </plugin>

      <!--
        Coverage is a diagnostic, not a target: `report` only, and deliberately no `check`
        goal. A percentage gate would reward tests written to reach lines rather than to
        state a rule. See docs/ADRs/ADR-017-test-strategy.md.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!--
        The shared Money vectors live outside this module, so the path is injected by Maven
        rather than resolved from the working directory: ${project.basedir} is correct however
        the build was invoked, and the test fails loudly if the property is absent.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <finassist.contracts.dir>${project.basedir}/../../contracts</finassist.contracts.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!--
        The split ADR-025 decides: surefire runs the unit suite and needs no Docker; failsafe runs
        everything named *IT against a real PostgreSQL and does. `verify` runs both, and
        `make test-ledger` already calls `verify`, so CI inherits this without a new target.

        `verify` is bound as well as `integration-test` on purpose - without it failsafe records
        failures and never reports them, and the build goes green over a red suite.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <finassist.contracts.dir>${project.basedir}/../../contracts</finassist.contracts.dir>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Mutation testing, opt in with:

        ./mvnw -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage

      The goal is named explicitly because it is deliberately not bound to any
      lifecycle phase: it re-runs the suite once per mutant and would multiply CI's runtime for
      a number nothing gates on. `test-compile` comes first because a direct goal invocation
      runs no lifecycle, so on a clean tree PIT finds no classes and aborts with "No mutations
      found". Coverage says which lines ran; this says whether the tests would
      notice if those lines were wrong, which is the question worth asking of a domain whose whole
      job is refusing things. See docs/ADRs/ADR-017-test-strategy.md.

      Scoped to the domain, the shared kernel, the application services and the composition root.
      LedgerApplicationIT and LedgerCompositionIT are excluded because PIT reruns tests per mutant
      and booting Spring each time buys nothing - the wiring they check has no mutable logic in it.
    -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest.version}</version>
            <configuration>
              <targetClasses>
                <param>io.github.naimelijah.finassist.ledger.*.domain.*</param>
                <param>io.github.naimelijah.finassist.ledger.shared.*</param>
                <!-- The application services hold the rules the domain could not: an entry matching
                     its account's currency, a unique account name, the categorisation fold. Coverage
                     rates all of them as covered, which is exactly the claim mutation testing exists
                     to check. Still gated on nothing (ADR-017); the scope grew, the decision did not. -->
                <param>io.github.naimelijah.finassist.ledger.*.application.service.*</param>
                <param>io.github.naimelijah.finassist.ledger.composition.*</param>
              </targetClasses>
              <excludedTestClasses>
                <param>io.github.naimelijah.finassist.ledger.LedgerApplicationIT</param>
                <param>io.github.naimelijah.finassist.ledger.LedgerArchitectureTest</param>
                <!-- Boots Tomcat once per mutant for wiring that holds no logic. -->
                <param>io.github.naimelijah.finassist.ledger.LedgerObservabilityIT</param>
                <param>io.github.naimelijah.finassist.ledger.composition.LedgerCompositionIT</param>
                <!-- Boots the full context (and, for the outage case, a JWKS HTTP server) to prove
                     wiring, not domain logic; PIT would rerun both per mutant for nothing gained. -->
                <param>io.github.naimelijah.finassist.ledger.LedgerAuthorizationIT</param>
                <param>io.github.naimelijah.finassist.ledger.LedgerKeySourceOutageIT</param>
              </excludedTestClasses>
              <excludedClasses>
                <!-- Excluded because LedgerCompositionIT, the test that exists to cover it, is excluded above.
                     Left in scope, every mutant planted in a @Bean method would be judged only by tests that
                     boot the whole application, and the report ADR-017 keeps to answer "would a test notice
                     this being wrong?" would fill up with noise no test change could ever clear. The
                     translations beside it stay in scope: they hold logic and have POJO tests. -->
                <param>io.github.naimelijah.finassist.ledger.composition.LedgerConfiguration</param>
              </excludedClasses>
              <outputFormats>
                <param>HTML</param>
                <param>CSV</param>
              </outputFormats>
              <timestampedReports>false</timestampedReports>
            </configuration>
            <dependencies>
              <!-- PIT needs a plugin matching the test library; this module is on JUnit Platform 6. -->
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
