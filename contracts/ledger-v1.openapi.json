{
  "components": {
    "schemas": {
      "AccountResponse": {
        "properties": {
          "currency": {
            "enum": [
              "ILS",
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ],
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "ASSET",
              "LIABILITY",
              "INCOME",
              "EXPENSE",
              "EQUITY"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "BalanceResponse": {
        "properties": {
          "account": {
            "format": "uuid",
            "type": "string"
          },
          "balance": {
            "$ref": "#/components/schemas/MoneyDto"
          }
        },
        "type": "object"
      },
      "EntryDto": {
        "properties": {
          "account": {
            "format": "uuid",
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/MoneyDto"
          }
        },
        "required": [
          "account",
          "amount"
        ],
        "type": "object"
      },
      "MoneyDto": {
        "properties": {
          "amount": {
            "pattern": "-?\\d+(\\.\\d+)?",
            "type": "string"
          },
          "currency": {
            "enum": [
              "ILS",
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ],
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "type": "object"
      },
      "OpenAccountRequest": {
        "properties": {
          "currency": {
            "enum": [
              "ILS",
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ],
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "ASSET",
              "LIABILITY",
              "INCOME",
              "EXPENSE",
              "EQUITY"
            ],
            "type": "string"
          }
        },
        "required": [
          "currency",
          "name",
          "type"
        ],
        "type": "object"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "items": {
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "RecordTransactionRequest": {
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryDto"
            },
            "maxItems": 2147483647,
            "minItems": 2,
            "type": "array"
          },
          "occurredOn": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "description",
          "entries",
          "occurredOn"
        ],
        "type": "object"
      },
      "TransactionResponse": {
        "properties": {
          "description": {
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/EntryDto"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "occurredOn": {
            "format": "date",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/TransactionStateResponse"
          }
        },
        "type": "object"
      },
      "TransactionStateResponse": {
        "properties": {
          "on": {
            "format": "date",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "CLEARED",
              "RECONCILED",
              "VOIDED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "TransitionRequest": {
        "properties": {
          "on": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "on"
        ],
        "type": "object"
      },
      "VoidRequest": {
        "properties": {
          "on": {
            "format": "date",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "on",
          "reason"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FinAssist ledger",
    "version": "v1"
  },
  "openapi": "3.1.0",
