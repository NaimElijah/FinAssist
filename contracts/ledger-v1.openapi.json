                  "items": {
                    "$ref": "#/components/schemas/AccountResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "A problem (RFC 9457)"
          }
        },
        "tags": [
          "account-controller"
        ]
      },
