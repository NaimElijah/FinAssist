# Local agent state — .claude/ itself stays tracked
.claude/settings.local.json

# Environment / secrets
.env
.env.*
!.env.example

# Database backups (ADR-038): the books, password hashes and TOTP secrets. Never `*.sql`,
# which is what the ledger's migrations are.
/backups/
*.dump

# Java / Maven
target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
dist/
*.egg-info/
# The assistant's generated OpenAPI document, written only when it differs from contracts/
backend/assistant/.contract-drift/

# Node / frontend
node_modules/
coverage/

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
