# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable here must also appear in the Configuration table in README.md.

# --- Ledger service (Java) ---------------------------------------------------
LEDGER_PORT=8080
# JDBC URL for the ledger database. Host is the Compose service name, not localhost.
LEDGER_DB_URL=jdbc:postgresql://db:5432/finassist
LEDGER_DB_USERNAME=finassist
LEDGER_DB_PASSWORD=

# --- Assistant service (Python) ----------------------------------------------
ASSISTANT_PORT=8000
# Base URL the assistant uses to reach the ledger's HTTP API.
LEDGER_BASE_URL=http://ledger:8080
# Anthropic API key for the LLM assistant. Never logged; redacted at the logging boundary.
ANTHROPIC_API_KEY=

# --- Database (Compose) ------------------------------------------------------
POSTGRES_DB=finassist
POSTGRES_USER=finassist
POSTGRES_PASSWORD=

# --- Observability -----------------------------------------------------------
# OTLP collector endpoint. Traces are dropped when unset; the services still start.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=finassist
