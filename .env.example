# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable here must also appear in the Configuration table in README.md.

# --- Ledger service (Java) ---------------------------------------------------
LEDGER_PORT=8080
# Interface the ledger binds. Loopback by default, kept as defence in depth now that the gateway
# fronts it too (ADR-030). Inside a container it must be 0.0.0.0, because the container's own
# loopback is unreachable from the host.
LEDGER_ADDRESS=127.0.0.1
# Comma-separated host names the ledger answers to. A request whose Host header names anything
# else is refused with 403, which is what stops a DNS-rebound page in your own browser from
# reading the books (ADR-030). Names only: an entry with a port, a colon or a bracket, which
# covers every IPv6 literal, is refused at start-up, because the ledger's check could never match
# it. Add a name here before reaching the ledger by it, or every request is refused.
LEDGER_ALLOWED_HOSTS=localhost,127.0.0.1
# JDBC URL for the ledger database. Compose sets this itself, to the service name `db`, for the
# `ledger` container; this default of `localhost` is what a native `./mvnw spring-boot:run`
# uses against the Compose `db` service's published port.
LEDGER_DB_URL=jdbc:postgresql://localhost:5432/finassist
# The ledger connects as the role the Compose container creates, so these two must match
# POSTGRES_USER and POSTGRES_PASSWORD below. They are separate variables because the ledger
# gets its own, less privileged role the day one exists (ADR-024). An empty password fails
# at start-up with a SCRAM error rather than connecting anonymously.
LEDGER_DB_USERNAME=finassist
LEDGER_DB_PASSWORD=
# The issuer every token's iss claim must name. Always the public URL a browser signed in
# against, never an internal one (ADR-030, ADR-031).
LEDGER_OIDC_ISSUER=http://localhost:8081/realms/finassist
# The JWKS URI the ledger fetches signing keys from, service-to-service. Compose overrides this
# with the internal address, http://keycloak:8080/realms/finassist/protocol/openid-connect/certs;
# this default is what a native `./mvnw spring-boot:run` uses against Keycloak's published port.
LEDGER_OIDC_JWKS_URI=http://localhost:8081/realms/finassist/protocol/openid-connect/certs

# --- Identity (Keycloak) ------------------------------------------------------
# The self-hosted identity provider (ADR-031). Its realm, committed at
# ops/keycloak/finassist-realm.json, is imported only into an empty database: editing the file,
# or one of the secrets below it takes, changes nothing for an existing keycloak-db-data volume
# until the realm is imported again. The README's "Changing the realm or its secrets" section
# gives both ways to do that, and what each deletes.
KEYCLOAK_PORT=8081
# The bootstrap admin account for Keycloak's own admin console (http://localhost:8081/admin),
# published on 127.0.0.1 only. Not one of FinAssist's own roles.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# keycloak-db's password. Its own database, its own volume (keycloak-db-data), no published
# port and no init script, so the owner's existing db-data volume is never touched by it
# (ADR-031).
KEYCLOAK_DB_PASSWORD=
# The owner's sign-in username in the finassist realm, seeded with the owner role.
FINASSIST_OWNER_USERNAME=owner
# A temporary password: the realm forces UPDATE_PASSWORD and CONFIGURE_TOTP at first sign-in, so
# this value is only ever used once. Must satisfy the realm's own policy
# (length(12) and notUsername and notEmail and passwordHistory(3)).
FINASSIST_OWNER_INITIAL_PASSWORD=
# The finassist-assistant Keycloak client's secret - a confidential, service-account-only client
# holding the assistant role, so the assistant can authenticate to the ledger with read-only
# access once its own HTTP client exists (#62; ADR-032). Any strong value: the realm holds only a
# placeholder, and Keycloak sets the client's secret from this value when it imports the realm.
ASSISTANT_CLIENT_SECRET=

# --- Gateway service (Java) --------------------------------------------------
# The backend-for-frontend. It signs the browser in through Keycloak and keeps every token
# server-side, and relays an authenticated request to the ledger and the assistant
# (ADR-030). Runs under Compose alongside Keycloak and its database.
GATEWAY_PORT=8090
# Interface the gateway binds. Loopback by default, matching the ledger and the assistant, kept
# as defence in depth alongside the OIDC sign-in (ADR-030). Inside a container it must be
# 0.0.0.0, because the container's own loopback is unreachable from the host.
GATEWAY_ADDRESS=127.0.0.1
# Comma-separated host names the gateway answers to. A request whose Host header names anything
# else is refused with 403, which is what stops a DNS-rebound page in your own browser from
# reaching the backend-for-frontend (ADR-030). Names only: an entry with a port, a colon or a
# bracket, which covers every IPv6 literal, is refused at start-up, because the gateway's check
# could never match it. Add a name here before reaching the gateway by it, or every request is
# refused.
GATEWAY_ALLOWED_HOSTS=localhost,127.0.0.1
# The origin your browser reaches FinAssist through: the Vite dev server, which proxies /bff to
# the gateway. Every redirect the gateway issues is absolute and built from this, never from a
# forwarded header. Use `localhost`, not `127.0.0.1`: cookies are keyed by host name, so opening
# the other one leaves the sign-in unable to find its own session.
GATEWAY_PUBLIC_URL=http://localhost:5173
# Keycloak as the browser sees it. The sign-in and sign-out URLs the gateway hands the browser are
# built from this, and so is the issuer every token must name.
GATEWAY_OIDC_PUBLIC_URL=http://localhost:8081
# Keycloak as the gateway itself reaches it. Running natively the two are the same; under Compose
# this becomes the container name, which the browser cannot resolve - which is why they are
# separate variables rather than one.
GATEWAY_OIDC_INTERNAL_URL=http://localhost:8081
# The gateway's Keycloak client secret. No default: the gateway refuses to start without it,
# rather than failing at your first sign-in. Any strong value: the realm holds only a placeholder,
# Keycloak sets the finassist-gateway client's secret from this value when it imports the realm,
# and the gateway signs in to Keycloak with the same value.
GATEWAY_CLIENT_SECRET=
# Whether the session and CSRF cookies carry `Secure`. False for development, which is plain HTTP
# on loopback - Safari refuses a Secure cookie over it. Must be true behind TLS.
GATEWAY_COOKIE_SECURE=false
# Where the gateway relays a request under /ledger/api/v1/** and /assistant/api/v1/** once its
# prefix is stripped, with the browser's access token attached and its own Cookie and CSRF
# header removed. Native defaults; Compose overrides both with the service names it gives the
# ledger and the assistant.
GATEWAY_LEDGER_URI=http://localhost:8080
GATEWAY_ASSISTANT_URI=http://localhost:8000
# Not a variable to set here: the gateway's outbound HTTP timeouts are fixed in application.yml
# (spring.http.clients.connect-timeout=5s, read-timeout=10s) rather than exposed as an
# environment variable, because Spring Cloud Gateway Server Web MVC has no timeout property of
# its own for its relay - this is Boot's own shared HTTP client setting instead. It bounds every
# outbound call this process makes, not only a relay: the gateway's own calls to Keycloak (the
# code exchange and the refresh_token grant) share the same auto-configured RestClient. Recorded
# here so raising it stays a one-line change to application.yml rather than a rediscovery.

# --- Assistant service (Python) ----------------------------------------------
ASSISTANT_PORT=8000
# Interface the assistant binds. Loopback by default, kept as defence in depth now that the
# gateway fronts it too (ADR-030). Inside a container it must be 0.0.0.0, because the
# container's own loopback is unreachable from the host.
ASSISTANT_HOST=127.0.0.1
# Comma-separated host names the assistant answers to. A request whose Host header names anything
# else is refused with 403, which stops a DNS-rebound page in your own browser from reading what
# the assistant serves (ADR-030). Names only: an entry containing a `:` or a `[`, which covers a
# port and every IPv6 literal, is refused at start-up, because the assistant's check could never
# match it; so is a wildcard, which would admit any host. Add a name here before reaching the
# assistant by it.
ASSISTANT_ALLOWED_HOSTS=localhost,127.0.0.1
# The issuer every bearer token's iss claim must name. Always the public URL a browser signed in
# against, never an internal one (ADR-030, ADR-031) - the ledger is configured with the same
# value, since both services trust the one realm. Refused at start-up unless it is an http(s) URL.
ASSISTANT_OIDC_ISSUER=http://localhost:8081/realms/finassist
# The JWKS URI the assistant fetches signing keys from, service-to-service. Compose overrides
# this with the internal address, http://keycloak:8080/realms/finassist/protocol/openid-connect/certs;
# this default is what a native run against Keycloak's published port uses. Also refused at
# start-up unless it is an http(s) URL.
ASSISTANT_OIDC_JWKS_URI=http://localhost:8081/realms/finassist/protocol/openid-connect/certs
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Anything else is refused at startup.
ASSISTANT_LOG_LEVEL=INFO
# Base URL the assistant would use to reach the ledger's HTTP API. Nothing reads this yet: the
# assistant has no ledger client, only the in-memory LedgerPort stand-in (ADR-004, ADR-021).
# Kept and documented ahead of that client rather than deleted quietly.
LEDGER_BASE_URL=http://ledger:8080
# Anthropic API key for the LLM assistant. Never logged; redacted at the logging boundary.
ANTHROPIC_API_KEY=
# Loads a small set of fictional holdings and quotes at start-up, so the portfolio screens have
# something to show by hand. Invented data, never meant for real use. Off by default.
ASSISTANT_DEV_SEED=false

# --- Database (Compose) ------------------------------------------------------
POSTGRES_DB=finassist
POSTGRES_USER=finassist
POSTGRES_PASSWORD=

# --- Observability -----------------------------------------------------------
# OTLP collector base URL, without a signal path. Each service appends its own.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Export is off unless this is true, for every signal: traces, metrics, and the ledger's OTLP log
# export, which nothing feeds until a log appender is added. Paired with the endpoint above rather
# than inferred from it, so a stale endpoint copied between machines goes quiet instead of
# retrying. Telemetry is dropped when off; the services still start either way.
OTEL_EXPORT_ENABLED=false

# Grafana admin password. Required whenever the `monitoring` Compose profile is used.
GRAFANA_ADMIN_PASSWORD=

# Host ports for the monitoring profile.
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
