# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every variable here must also appear in the Configuration table in README.md.

# --- Ledger service (Java) ---------------------------------------------------
LEDGER_PORT=8080
# JDBC URL for the ledger database. localhost, because the ledger runs natively on the host
# while only Postgres is in Compose; it becomes the service name `db` the day the ledger
# joins docker-compose.yml.
LEDGER_DB_URL=jdbc:postgresql://localhost:5432/finassist
# The ledger connects as the role the Compose container creates, so these two must match
# POSTGRES_USER and POSTGRES_PASSWORD below. They are separate variables because the ledger
# gets its own, less privileged role the day one exists (ADR-024). An empty password fails
# at start-up with a SCRAM error rather than connecting anonymously.
LEDGER_DB_USERNAME=finassist
LEDGER_DB_PASSWORD=

# --- Assistant service (Python) ----------------------------------------------
ASSISTANT_PORT=8000
# Interface the assistant binds. Loopback by default; nothing runs it in a container yet.
ASSISTANT_HOST=127.0.0.1
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Anything else is refused at startup.
ASSISTANT_LOG_LEVEL=INFO
# Base URL the assistant uses to reach the ledger's HTTP API.
LEDGER_BASE_URL=http://ledger:8080
# Anthropic API key for the LLM assistant. Never logged; redacted at the logging boundary.
ANTHROPIC_API_KEY=

# --- Database (Compose) ------------------------------------------------------
POSTGRES_DB=finassist
POSTGRES_USER=finassist
POSTGRES_PASSWORD=

# --- Observability -----------------------------------------------------------
# OTLP collector base URL, without a signal path. Both services append their own.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Export is off unless this is true, for traces and metrics alike. Paired with the endpoint
# above rather than inferred from it, so a stale endpoint copied between machines goes quiet
# instead of retrying. Telemetry is dropped when off; the services still start either way.
OTEL_EXPORT_ENABLED=false

# Grafana admin password. Required whenever the `monitoring` Compose profile is used.
GRAFANA_ADMIN_PASSWORD=

# Host ports for the monitoring profile.
OTLP_HTTP_PORT=4318
OTLP_GRPC_PORT=4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
