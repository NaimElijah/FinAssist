# Authoritative whitespace rules. The language formatters (Spotless, Ruff) own
# everything else; where the two overlap, the formatter wins.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{java,py}]
indent_size = 4

[*.{json,yml,yaml,xml,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false  # two trailing spaces are a hard line break

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
